rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function allowedFields() {
      return ['uid','displayName','email','provider','createdAt','updatedAt','lastSignInAt','lastActiveAt'];
    }
    match /profiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(allowedFields())
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastActiveAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && resource.data.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(allowedFields())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['displayName','email','provider','updatedAt','lastSignInAt','lastActiveAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastActiveAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // Create the admin document manually from the trusted Firebase console.
    // No client, including a signed-in user, can promote themselves.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
